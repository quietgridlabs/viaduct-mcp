# Where the Viaduct API lives. Required.
C4_API_URL=https://c4.quietgridlabs.com

# stdio | streamable-http. Deployed servers use streamable-http.
C4_MCP_TRANSPORT=streamable-http
C4_MCP_HOST=0.0.0.0
C4_MCP_PORT=8080
C4_MCP_LOG_LEVEL=info
C4_MCP_TIMEOUT=30
# Max tools/call per bearer fingerprint per minute on HTTP (0 = off).
# Default when unset: 120 on streamable-http, 0 on stdio.
# C4_MCP_RATE_LIMIT=120

# Optional default so tools can omit projectId.
# C4_DEFAULT_PROJECT_ID=
